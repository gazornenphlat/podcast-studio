# Copy to .env and fill in only the sites you use. Never share or commit .env.

# Public web address of your videos/ folder (only needed for Threads),
# e.g. an S3 / Cloudflare R2 bucket: https://media.example.com/videos
MEDIA_BASE_URL=

# --- YouTube / YouTube Shorts ---
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- X / Twitter (paid API tier with media upload) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- TikTok (Content Posting API, video.publish scope) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Facebook Page ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- Instagram (Business/Creator account) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Threads ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Vimeo ---
VIMEO_ACCESS_TOKEN=
VIMEO_PRIVACY=anybody

# --- Tumblr ---
TUMBLR_BLOG=myblog.tumblr.com
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=

# --- Dailymotion ---
DAILYMOTION_API_KEY=
DAILYMOTION_API_SECRET=
DAILYMOTION_USERNAME=
DAILYMOTION_PASSWORD=
DAILYMOTION_CHANNEL=lifestyle

# --- Odysee (needs lbrynet running locally) ---
ODYSEE_CHANNEL=@mychannel
ODYSEE_BID=0.001
LBRYNET_URL=http://localhost:5279

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX
LINKEDIN_VERSION=202509

# --- Pinterest ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Bluesky (use an app password) ---
BLUESKY_HANDLE=me.bsky.social
BLUESKY_APP_PASSWORD=

# --- Mastodon ---
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Telegram channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@mychannel
