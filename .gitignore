# ---------------------------------------------------------------
#  Podcast Studio – .gitignore
#  Tracks code, docs and config templates. Leaves out secrets,
#  generated episodes, per-machine state and large media.
# ---------------------------------------------------------------

# --- Secrets -------------------------------------------------------
content_scheduler/secrets.yaml
content_scheduler/google_credentials.json
content_scheduler/google_token.json
.env
*.env

# --- Generated episodes and run output ---------------------------
podcast_pipeline/*/output/
**/_*_tmp.*
**/*_tmp.mp4
**/*_tmp.mp3
**/*_tmp.wav

# --- Per-machine run state ---------------------------------------
podcast_pipeline/*/sequence.json
podcast_pipeline/*/progress.json
podcast_pipeline/*/progress.tmp

# --- Working scripts (content, changes every run) ---------------
podcast_pipeline/**/script.txt
podcast_pipeline/**/script-in.txt
podcast_pipeline/**/script_tts.txt

# --- Large media in assets/ (keep the README) -------------------
podcast_pipeline/*/assets/*
!podcast_pipeline/*/assets/README.txt
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.mp3
*.wav
*.m4a
*.flac
*.ogg

# --- TTS / LLM models ----------------------------------------------
*.onnx
*.onnx.json
*.bin
voices/

# --- Content Scheduler runtime ------------------------------------
content_scheduler/data.json
content_scheduler/data.json.tmp
content_scheduler/backups/
content_scheduler/inbox/
content_scheduler/tray.log
content_scheduler/series.yaml.tmp

# --- Stray copies and backups -------------------------------------
*-old
*.old
*.bak
* - Copy*
*~

# --- Python --------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# --- Editors / OS --------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
~$*.docx
